// Strucure for input data as sent by the application.
struct VertexInput
{
	in float3 Position 	: ATTR0;
	in float3 Normal	: ATTR2;
	in float2 Tex		: ATTR8;
	in float3 Tangent	: ATTR14;
	in float3 BiTangent	: ATTR15;
};

// Structure for data transferred from the vertex to the fragment program.
struct VertexOutput
{
	float4 PosH		: HPOS;
	float4 PosVS		: TEXCOORD0;
	float3 Normal	: TEXCOORD1;
	float3 Tangent	: TEXCOORD2;
	float3 BiTangent: TEXCOORD3;
	float2 Tex		: TEXCOORD4;
	float Depth		: TEXCOORD5;
};

// Structure for data output from the fragment program.
struct FragmentOutput
{
	float4 Color0	: COLOR0;
	float4 Color1	: COLOR1;
	float4 Color2	: COLOR2;
	float4 Color3	: COLOR3;
	float Depth		: DEPTH;
	// NOTE: COLOR* semantics go from 0 through 7, according to http://http.developer.nvidia.com/Cg/glslf.html
};

// Additional input data that we don't want to have in the VertexInput struct.
sampler2D DiffuseSampler		: LKDIFFUSETEX;
sampler2D NormalSampler			: LKNORMALTEX;
sampler2D SpecularSampler		: LKSPECULARTEX;
sampler2D EmissiveSampler		: LKEMISSIVETEX;
samplerCUBE EnvSampler			: LKSKYSAMPLER;
float4 GlobalAmbient			: LKGLOBALAMBIENT;
float4x4 ModelViewProjection	: LKMODELVIEWPROJ;
float4x4 ModelMatrix			: LKMODELMATRIX;
float3x3 ModelMatrixIT			: LKMODELMATRIXIT;
float4x4 ViewMatrix				: LKVIEWMATRIX;
float4 EyePosition				: LKEYEPOSITION;
float2 UVScale					: LKUVSCALE = float2(1.0, 1.0);
float zFar						: LKZFAR;
float zNear						: LKZNEAR;
float MaterialShininess			: LKMATERIALSHININESS;
float MaterialReflectivity		: LKMATERIALREFLECTIVITY;

float3 PackNormal( float3 _UnpackedNormal )
{
	return (_UnpackedNormal + 1.0) * 0.5;
}

float3 UnpackNormal( float3 _PackedNormal )
{
	return (_PackedNormal * 2.0) - 1.0;
}

// Vertex program entry point.
VertexOutput mainVP( VertexInput IN )
{
	VertexOutput OUT;
	
	OUT.PosH = mul(ModelViewProjection, float4(IN.Position, 1.0));
	OUT.PosVS = mul(mul(ViewMatrix, ModelMatrix), float4(IN.Position, 1.0));
	OUT.Tex = IN.Tex * UVScale;
	OUT.Normal = IN.Normal;
	OUT.Tangent = IN.Tangent;
	OUT.BiTangent = IN.BiTangent;
	OUT.Depth = OUT.PosH.z;

	return OUT;
}

// Fragment program entry point.
FragmentOutput mainFP( VertexOutput IN )
{
	FragmentOutput OUT;

	// View-space position in RGB and material shininess in A.
	OUT.Color1 = float4(IN.PosVS.xyz, MaterialShininess);

	// View-space normal.
	float3x3 TBN = float3x3(normalize(IN.Tangent), normalize(IN.BiTangent), normalize(IN.Normal));
	float3 TangentSpaceNormal = (float3(tex2D(NormalSampler, IN.Tex).rgb) * 2.0) - 1.0;
	float3 WorldSpaceNormal = mul(ModelMatrixIT, mul(transpose(TBN), TangentSpaceNormal));	// Finally: I needed the transpose of the TBN...
	float3 ViewSpaceNormal = mul(float3x3(ViewMatrix), WorldSpaceNormal);
	OUT.Color2.rgb = PackNormal(ViewSpaceNormal);

	//OUT.Color2.rgb = PackNormal(mul(float3x3(ViewMatrix), mul(ModelMatrixIT, IN.Normal)));
	
#define REFLECTION
	
	// Diffuse color in RGB and specular power in A.
	float3 DiffuseSample = tex2D(DiffuseSampler, IN.Tex).rgb;
	float SpecularSample = tex2D(SpecularSampler, IN.Tex).r;
#ifndef REFLECTION
	OUT.Color0 = float4(DiffuseSample, SpecularSample);
#else
	float3 ReflectionVector = mul(float3x3(inverse(ViewMatrix)), normalize(reflect(IN.PosVS.xyz, ViewSpaceNormal)));
	//float3 ReflectionVector = mul(float3x3(inverse(ViewMatrix)), normalize(IN.PosVS.xyz));

	float3 EnvironmentSample = texCUBE(EnvSampler, ReflectionVector);
	OUT.Color0 = float4( (DiffuseSample * (1.0 - MaterialReflectivity)) + (MaterialReflectivity * EnvironmentSample), SpecularSample);
#endif
	
	// Emissive color.
	OUT.Color3 = float4(tex2D(EmissiveSampler, IN.Tex).rgb, 1.0);

	return OUT;
}

technique t0
{
	pass p0
	{
		CullFaceEnable = true;
		CullFace = Back;
		DepthTestEnable = true;
		DepthFunc = LEqual;
		DepthMask = true;
		BlendEnable = false;
		ColorMask = bool4(true, true, true, true);
		StencilEnable = false;

		VertexProgram = compile latest mainVP();
		FragmentProgram = compile latest mainFP();
	}
}